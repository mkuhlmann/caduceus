{
	"id": "./",
	"name": "Caduceus",
	"short_name": "Caduceus",
	"description": "Chat with Hermes Agent and manage its schedules, skills and board.",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"background_color": "#1e1d1d",
	"theme_color": "#1e1d1d",
	"launch_handler": { "client_mode": ["focus-existing", "auto"] },
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"shortcuts": [
		{
			"name": "Chat",
			"url": "./#/chat",
			"icons": [{ "src": "icons/shortcut-chat.png", "sizes": "96x96", "type": "image/png" }]
		},
		{
			"name": "Bots",
			"url": "./#/bots",
			"icons": [{ "src": "icons/shortcut-bots.png", "sizes": "96x96", "type": "image/png" }]
		}
	]
}
