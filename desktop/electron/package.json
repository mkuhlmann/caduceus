{
	"name": "caduceus-desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Desktop shell for Caduceus",
	"author": "Manuel Kuhlmann",
	"main": "main.cjs",
	"scripts": {
		"start": "electron .",
		"dist": "electron-builder",
		"dist:win": "electron-builder --win --x64"
	},
	"build": {
		"appId": "org.mkuhlmann.caduceus",
		"productName": "Caduceus",
		"files": [
			"main.cjs",
			"preload.cjs"
		],
		"extraResources": [
			{
				"from": "../../dist",
				"to": "dist"
			},
			{
				"from": "../../dist-bin/${os}-${arch}",
				"to": "server"
			}
		],
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Utility"
		},
		"mac": {
			"target": [
				"dmg"
			]
		},
		"win": {
			"target": [
				"zip"
			],
			"extraFiles": [
				{
					"from": "build/portable",
					"to": "portable"
				}
			],
			"artifactName": "${productName}-${version}-${arch}-portable.${ext}"
		}
	},
	"devDependencies": {
		"electron": "^39.0.0",
		"electron-builder": "^26.0.0"
	}
}
